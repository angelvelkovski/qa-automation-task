# Copy to .env (done automatically by `npm test`). Nothing here is hardcoded in code or config.
UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# saucedemo public demo accounts
STANDARD_USER=standard_user
STANDARD_PASSWORD=secret_sauce
PROBLEM_USER=problem_user
PROBLEM_PASSWORD=secret_sauce

# saucedemo sales tax rate used to compute the expected tax
TAX_RATE=0.08

# jsonplaceholder is a fake API: it accepts POST but never stores. Set true only when pointing at a real service.
API_PERSISTS_DATA=false
