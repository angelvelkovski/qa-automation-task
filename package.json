{
  "name": "qa-automation-task",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI/API automation framework",
  "scripts": {
    "pretest": "node scripts/ensure-env.js",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-standard --project=ui-problem",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure": "npm run allure:generate && npm run allure:open",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
